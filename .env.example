# Copy this file to .env.local and fill in the real values.
# .env.local is git-ignored — never commit secrets.

# Apps Script web app for the demo data layer (lib/api.ts + /api/items, /api/orders).
# Server-side only — no NEXT_PUBLIC prefix.
APPS_SCRIPT_URL=https://script.google.com/macros/s/PASTE_DEPLOYMENT_ID/exec

# The /exec URL of your deployed Apps Script web app (required)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/PASTE_DEPLOYMENT_ID/exec

# Timeout (ms) for Apps Script calls (optional)
APPS_SCRIPT_TIMEOUT_MS=15000

# Admin console password (required to use /admin)
ADMIN_PASSWORD=change-me

# Signed admin session secret (optional — derived from ADMIN_PASSWORD if empty)
ADMIN_SESSION_SECRET=

# Admin session lifetime in hours (optional, default 12)
ADMIN_SESSION_TTL_HOURS=12
